# Copy this file to .env and fill in real values. Never commit .env itself.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# --- Free-tier deployment on Render ---
# Render's free PostgreSQL add-on gives you a connection string automatically
# and injects it as DATABASE_URL — you don't need to set the DB_* vars below
# when using it. Just leave DATABASE_URL unset locally.
DATABASE_URL=

# --- Local quick testing without any database server ---
# Set to True to use SQLite instead (ignored if DATABASE_URL is set above)
USE_SQLITE=True

# --- Self-hosted MySQL (e.g. on a VPS) ---
# Only used if DATABASE_URL is empty AND USE_SQLITE=False
DB_NAME=pensionease_db
DB_USER=pensionease_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
